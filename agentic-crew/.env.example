# =============================================================================
# agentic-crew configuration
# Copy to .env and fill in. Every value can also be set in the environment.
# =============================================================================

# --- The gateway -----------------------------------------------------------
# The crew makes every model call through Conduit. This is the same base URL
# and token the admin panel and the Python SDK use.
CONDUIT_BASE_URL=http://localhost:9812
CONDUIT_API_KEY=sk-...

# --- Where things live -----------------------------------------------------
# The directory scanned for agent YAML files.
AGENTIC_CREW_AGENTS_DIR=agents
# The vector store and ingested documents.
AGENTIC_CREW_DATA_DIR=data
# The cheap model used for routing between agents.
AGENTIC_CREW_DEFAULT_MODEL=glm-5.3

# --- Embeddings ------------------------------------------------------------
# "fastembed" runs a local ONNX model: no API cost, works offline.
# "openai" uses an OpenAI-compatible embedding endpoint instead.
AGENTIC_CREW_EMBEDDING_BACKEND=fastembed
AGENTIC_CREW_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
AGENTIC_CREW_EMBEDDING_DIMENSIONS=384
# Only for the "openai" backend.
# AGENTIC_CREW_EMBEDDING_BASE_URL=https://api.example.com/v1
# AGENTIC_CREW_EMBEDDING_API_KEY=sk-...

# --- The HTTP service ------------------------------------------------------
# The service binds to loopback by default. Set a token before exposing it to
# anything, n8n included.
AGENTIC_CREW_HOST=127.0.0.1
AGENTIC_CREW_PORT=8787
# AGENTIC_CREW_API_KEY=change-me

# --- Extra skills ----------------------------------------------------------
# Additional skill folders appended to every agent, separated by colons.
# AGENTIC_CREW_EXTRA_SKILLS=~/skills/common
