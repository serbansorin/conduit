{
  "name": "Conduit — ask the agent crew",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "conduit-question",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000001",
      "name": "Question Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-260, 0],
      "webhookId": "conduit-question"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CONDUIT_CREW_URL || 'http://127.0.0.1:8787' }}/run",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.AGENTIC_CREW_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ question: $json.body.question, agent: $json.body.agent || null }) }}",
        "options": { "timeout": 120000 }
      },
      "id": "a1000000-0000-4000-8000-000000000002",
      "name": "Ask the orchestrator",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000003",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [260, 0]
    }
  ],
  "connections": {
    "Question Webhook": {
      "main": [[{ "node": "Ask the orchestrator", "type": "main", "index": 0 }]]
    },
    "Ask the orchestrator": {
      "main": [[{ "node": "Respond", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "pinData": {},
  "meta": { "instanceId": "conduit-agentic-crew" },
  "tags": []
}
