# =============================================================================
# Conduit environment configuration
# Copy this file to .env or set the variables in your environment.
# =============================================================================

# --- Server ---
# Default: 9812 (an uncommon port, so it rarely collides with local services)
PORT=9812

# --- Admin panel ---
# Admin panel password. The server refuses to start with the default.
ADMIN_PASSWORD=admin
# JWT signing secret. Must be at least 32 bytes. The server refuses to start
# with the built-in default.
JWT_SECRET=conduit-default-secret-change-me

# --- Database ---
# SQLite file path. On Zeabur, mount a persistent volume at /data.
DB_PATH=./data/conduit.db

# --- Upstream ---
# OpenCode Go subscription endpoint.
GO_BASE_URL=https://opencode.ai/zen/go
# OpenCode Go API key. When set, it is auto-added to the "go" key pool on
# startup, so the gateway works without any manual key entry. You can still
# add more keys through the admin panel.
# GO_API_KEY=opencode_xxxx
# Ollama Cloud endpoint (OpenAI-compatible).
OLLAMA_BASE_URL=https://ollama.com

# --- Model routing ---
# Rewrite the model a client asks for before forwarding it upstream.
# Supports an inline JSON object or a file path.
# Example: {"gpt-5.5":"glm-5.1"}
# MODEL_MAPPINGS={"gpt-5.5":"glm-5.1"}
# MODEL_MAPPING_FILE=./config/model-mapping.example.json

# Family aliases. A source ending in "*" matches every model id with that
# prefix that is not itself a registered route. Claude Code always asks for
# "claude-sonnet-4-5-…" style ids, so this is what makes it work.
# Example: {"claude-*":"claude-haiku-5-5"}
# MODEL_ALIASES={"claude-*":"claude-haiku-5-5"}

# Serve this model when a client asks for one the gateway does not know.
# Leave empty to reject unknown models with 404.
# MODEL_FALLBACK=claude-haiku-5-5

# --- Billing ---
# Per-group multipliers applied to the recorded cost.
# Accepts JSON or a comma-separated list. Unset groups use 1.0.
# GROUP_MULTIPLIERS={"default":1,"go":0.8}
# GROUP_MULTIPLIERS=default=1,go=0.8

# --- Timeouts ---
# Upstream timeout for non-streaming requests, in seconds. 0 disables the
# gateway deadline. Streaming responses are never cut short.
UPSTREAM_TIMEOUT=0

# --- Strictness ---
# "disabled" (default) rejects unknown models with 404.
# "go" forwards unknown models to the Go upstream as-is.
PASSTHROUGH_MODE=disabled
